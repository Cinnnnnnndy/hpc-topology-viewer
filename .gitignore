# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
dist-single/

# Standalone single-file exports (generated on demand, delivered to user, not committed)
fullpod-supernode.html
*.standalone.html
pto-knowledge-report.html
*-report.html

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

